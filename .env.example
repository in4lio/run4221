APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/run4221.sqlite3
SEED_INITIAL_EVENTS=true
SEED_EVENTS_PATH=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=@run4221bot
TELEGRAM_CHANNEL_ID=@run4221
TELEGRAM_MODERATOR_IDS=

AI_EXTRACTOR_PROVIDER=heuristic
RUN4221_PROMPT_SOURCE=file
RUN4221_PROMPT_DIR=private/prompts
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.4-mini

# Standalone researcher worker (disabled until the production canary is approved).
RESEARCHER_ENABLED=false
RESEARCHER_DISCOVERY_ENABLED=false
RESEARCHER_RENDERING_ENABLED=false
RESEARCHER_MODEL=gpt-5.6-luna
RESEARCHER_INTERVAL_SECONDS=3600
RESEARCHER_MAX_EVENTS_PER_CYCLE=5
RESEARCHER_MAX_CANDIDATES_PER_CYCLE=3
RESEARCHER_MAX_AGENT_TURNS_PER_JOB=6
RESEARCHER_MAX_WEB_SEARCHES_PER_JOB=2
RESEARCHER_MAX_STATIC_PAGES_PER_JOB=4
RESEARCHER_MAX_RENDERED_PAGES_PER_JOB=0
RESEARCHER_MAX_RETRIES_PER_JOB=2
RESEARCHER_MAX_OUTPUT_TOKENS_PER_JOB=2000
RESEARCHER_MAX_WALL_TIME_SECONDS_PER_JOB=90
RESEARCHER_MAX_PENDING_SUGGESTIONS=20
RESEARCHER_MAX_PENDING_UPDATES=50
